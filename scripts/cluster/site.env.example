# Copy to scripts/cluster/site.env (git-ignored) and edit for your cluster.
# Every value has a working default, so an unconfigured site still runs -- locally.

# How to submit. "slurm" uses sbatch; "local" runs the command in the foreground,
# which is what you want on a workstation or inside an interactive allocation.
# Leave unset to auto-detect: slurm if sbatch is on PATH, else local.
#ALBENCH_BACKEND=slurm

# Absolute path to sbatch, if it is not on PATH. (On some clusters it lives under
# /cm/shared/apps/slurm/current/bin and login shells do not pick it up.)
#ALBENCH_SBATCH=/usr/bin/sbatch

# How to invoke Python. The default assumes uv; use "python" for a plain venv, or
# prefix module loads: "module load cuda/12.4 && python".
#ALBENCH_PYTHON="uv run --no-sync python"

# Partitions. GPU work and CPU work often live in different ones.
#ALBENCH_GPU_PARTITION=gpu
#ALBENCH_CPU_PARTITION=cpu

# Accounting. Many clusters require --account; leave empty if yours does not.
#ALBENCH_ACCOUNT=

# Quality-of-service tiers, highest priority first, as "name:maxwall".
# `submit.sh --tiered` spreads jobs across these, asking the scheduler where each
# job would actually start. One entry is fine.
#ALBENCH_TIERS="short:03:30:00 normal:11:30:00 long:11:30:00"

# Node selection for jobs that need a specific accelerator. LSTM training is ~7.6x
# slower on V100 than H100, so it is worth constraining; CNNs are not.
#ALBENCH_GPU_CONSTRAINT=h100

# Where the repo lives on the compute nodes, if not the directory you submit from.
#ALBENCH_REPO=/path/to/ALBench-S2F
